diff --git a/user/load.c b/user/load.c
new file mode 100644
index 0000000..4cd32d1
--- /dev/null
+++ b/user/load.c
@@ -0,0 +1,71 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+void print_float(float num)
+{
+
+  int int_part = (int)num;                         // Get the integer part
+  int decimal_part = (int)((num - int_part) * 10); // Get the first decimal place
+  printf("%d.%d ", int_part, decimal_part);       // Print the result
+}
+
+int main(int argc, char *argv[])
+{
+  // Check for correct usage
+  if (argc != 3)
+  {
+    printf("Usage: load <childCount> <allocationAmount>\n");
+    exit(1);
+  }
+
+  int childCount = atoi(argv[1]);
+  int allocationAmount = atoi(argv[2]);
+  printf("Parent going to sleep.\n");
+  for (int i = 0; i < childCount; i++)
+  {
+    int pid = fork();
+    if (pid == 0)
+    {
+      // In child process
+      printf("Child created.\n");
+      char *allocated_memory = malloc(allocationAmount);
+      if (allocated_memory == 0)
+      {
+        printf("Child failed to allocate memory.\n");
+        exit(1);
+      }
+      printf("Child allocated %d bytes.\n", allocationAmount);
+      printf("Child going to sleep.\n");
+      sleep(1000); // Sleep for a large amount of time
+      exit(0);
+    }
+    sleep(10);
+  }
+
+  
+  // In parent process
+  sleep(100); // Sleep for a large time to ensure all children are done
+  struct procInfo procinfo;
+
+  // Call the info system call to get process info
+  if (info(&procinfo) < 0)
+  {
+    printf("Failed to get process info.\n");
+    exit(1);
+  }
+
+  // Print the system information in the desired format
+  printf("Parent wake up.\n");
+  printf("Current system information:\n");
+  printf("Processes: %d/%d\n", procinfo.activeProcess, procinfo.totalProcess);
+  float memsize_mb = (float)procinfo.memsize / (1024 * 1024);
+  float totalMemSize_mb = (float)procinfo.totalMemSize / (1024 * 1024);
+
+  printf("RAM: ");
+  print_float(memsize_mb);
+  printf(" /");
+  print_float(totalMemSize_mb);
+  printf(" (in MB)\n");
+
+  exit(0);
+}
